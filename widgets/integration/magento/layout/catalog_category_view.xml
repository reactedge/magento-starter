<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
<!--        <move element="intentdiscovery-widget"-->
<!--              destination="content"-->
<!--              before="-" />-->
        <referenceContainer name="before.body.end">
            <block name="intentdiscovery-widget"
                   class="ReactEdge\WidgetBridge\Block\Widget"
                   template="ReactEdge_WidgetBridge::intentdiscovery.phtml"
                   ifconfig="reactedge/intentdiscovery/enabled">

                <arguments>
                    <argument name="widget_id" xsi:type="string">intentdiscovery</argument>
                    <argument name="view_model"
                              xsi:type="object">ReactEdge\WidgetBridge\ViewModel\Widget</argument>
                </arguments>

            </block>
        </referenceContainer>
    </body>
</page>
