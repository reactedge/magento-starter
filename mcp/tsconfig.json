{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@reactedge/*": [
        "./packages/widget-build/shared-resources/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "config.ts",
    "resources/**/*.ts",
    "tools/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts"
  ]
}
